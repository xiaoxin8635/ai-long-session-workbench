# ============================================================
# AI 长会话知识工作台 - 本地环境变量模板
#
# 使用方式：复制本文件为同目录下的 .env 并填写真实值
#          （.env 已被 .gitignore 排除，严禁提交到仓库）
#
# 生成强密码（PowerShell，32 位十六进制）：
#   -join ((1..32) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=workbench
POSTGRES_PASSWORD=change-me
POSTGRES_DB=workbench
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- 前端 web（M-F6 起 EchoDesk 自研前端，接管 3000）----------
WEB_PORT=3000
# npm 镜像源（构建前端镜像用；国内默认 npmmirror，海外可改回官方源）
# NPM_REGISTRY=https://registry.npmmirror.com

# ---------- memory-service ----------
# JWT 签名密钥（生成方式同上，48 位十六进制）
MEMORY_JWT_SECRET=change-me
MEMORY_SERVICE_PORT=8100

# ---------- LLM（M-08 Chat 端点，OpenAI 兼容协议）----------
# 示例（DeepSeek）：LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
# 示例（通义）：    LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---------- 抽取模型（M-04 记忆抽取/仲裁，可选）----------
# 留空则复用 LLM_MODEL；建议配置便宜的小模型（如 qwen-turbo）降低抽取成本
EXTRACTOR_MODEL=

# ---------- Embedding（M-04 记忆向量，本地 infinity 服务）----------
# 模型目录挂载源（宿主机 modelscope 缓存，含 BAAI/bge-m3）
EMBEDDING_MODELS_DIR=D:\ai_models\modelscope_cache\models
EMBEDDING_PORT=7997
# memory-service 访问地址（容器网络内走服务名，一般不改）
# EMBEDDING_BASE_URL=http://embedding:7997
# 模型名用 infinity 注册名（repo id，如 BAAI/bge-m3）而非挂载路径——
# 路径式名会被 infinity 400 拒绝（Available model names 见启动日志）
# EMBEDDING_MODEL=BAAI/bge-m3

# ---------- Rerank（M-07 RAG 精排，同一 infinity 服务）----------
# 模型已随 compose 挂载（rerank/BAAI/bge-reranker-large）；留空则复用
# EMBEDDING_BASE_URL 与 EMBEDDING_MODEL 时同款默认值，一般不改
# RERANK_MODEL=BAAI/bge-reranker-large
# RERANK_BASE_URL=http://embedding:7997
# 精排开关：bge-reranker-large 纯 CPU 单请求 20~90s 不可用，本地默认 false
# （知识检索降级 RRF 融合直排）；GPU 环境置 true 启用精排
# RERANK_ENABLED=false

# ---------- 上下文预算（M-05）----------
# 预算 profile 目录（config/budgets/*.yaml）挂载源；一般不改（默认仓库根 config/）
# CONFIG_DIR=../config
# 默认 profile 名；可用 default / memory_first / knowledge_first
# MEMORY_SERVICE_CONTEXT_BUDGET_PROFILE=default

# ---------- Open WebUI Pipe 服务账号（已退役：M-F6 起前端直连，Pipe 归档于 deploy/pipes/）----------
# 历史部署仍在用 Open WebUI + Pipe 时才需要填写
ECHODESK_PIPE_PASSWORD=

# ---------- Langfuse 观测栈（M-12，默认不启用；启用步骤见 docs/04 §2.9）----------
# 启用：填好本节全部密钥 → docker compose --profile observability up -d →
#       取消下一节 MEMORY_SERVICE_LANGFUSE_PUBLIC_HOST 注释 → 重建 memory-service
# 生成强密钥（PowerShell，64 位十六进制）：
#   -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
LANGFUSE_PORT=3001
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me
# 恰 64 位十六进制（32 字节）
LANGFUSE_ENCRYPTION_KEY=change-me
LANGFUSE_POSTGRES_PASSWORD=change-me
LANGFUSE_CLICKHOUSE_PASSWORD=change-me
LANGFUSE_REDIS_AUTH=change-me
# MinIO 密码至少 8 字符
LANGFUSE_MINIO_ROOT_PASSWORD=change-me
# headless 初始化（首启自动建 org/project/admin；key 自选，前缀建议 pk-lf-/sk-lf-）
LANGFUSE_PUBLIC_KEY=pk-lf-0000000000000000000000000000000000000000000
LANGFUSE_SECRET_KEY=sk-lf-0000000000000000000000000000000000000000000
LANGFUSE_INIT_USER_EMAIL=admin@echodesk.local
LANGFUSE_INIT_USER_NAME=EchoDesk Admin
# UI 登录密码至少 8 字符
LANGFUSE_INIT_USER_PASSWORD=change-me

# ---------- memory-service → Langfuse 上报（M-12；三项任一为空即 no-op）----------
# 容器网络内地址；取消注释并重启 memory-service 即开启上报
# MEMORY_SERVICE_LANGFUSE_PUBLIC_HOST=http://langfuse-web:3000

# ---------- MCP 外部工具（M-08 M3，默认关闭）----------
# JSON 数组配置外部 MCP server，启动期接入；工具以 mcp.<server>.<tool> 命名注册。
# http 必填 url / stdio 必填 command；可选 env（stdio 环境变量）、enabled:false（跳过）。
# 示例（详见 docs/04 §2.10）：
# MEMORY_SERVICE_MCP_SERVERS_JSON=[{"name":"weather","transport":"http","url":"http://host.docker.internal:8000/mcp"}]
# MCP 工具风险分级（默认 external=执行前必须用户确认；M-08 M3 D1 决策）
# MEMORY_SERVICE_MCP_TOOL_RISK=external
# 连接与调用超时（秒）
# MEMORY_SERVICE_MCP_CONNECT_TIMEOUT_SECONDS=10
# MEMORY_SERVICE_MCP_CALL_TIMEOUT_SECONDS=60
