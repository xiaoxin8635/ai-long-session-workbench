# ============================================================
# EchoDesk memory-service - 服务配置模板
#
# 使用方式：复制为 services/memory-service/.env（已被 git 忽略）
# 注意：Docker Compose 部署时变量由 deploy/.env + compose 注入，
#       本文件主要用于本地裸跑（不走容器）场景。
# ============================================================

# ---- 应用 ----
MEMORY_SERVICE_HOST=0.0.0.0
MEMORY_SERVICE_PORT=8100
MEMORY_SERVICE_LOG_LEVEL=INFO

# ---- 数据库（本地裸跑指向宿主机映射端口；容器内指向 postgres 服务名）----
MEMORY_SERVICE_DATABASE_URL=postgresql+asyncpg://workbench:change-me@localhost:5432/workbench
# 可选：显式指定 alembic 同步 URL（默认自动由 DATABASE_URL 转换）
# MEMORY_SERVICE_DATABASE_SYNC_URL=postgresql+psycopg://workbench:change-me@localhost:5432/workbench

# ---- Redis ----
MEMORY_SERVICE_REDIS_URL=redis://localhost:6379/0

# ---- 认证（生产必须换强随机值）----
MEMORY_SERVICE_JWT_SECRET=change-me-to-a-strong-random-secret
MEMORY_SERVICE_JWT_EXPIRE_MINUTES=30
MEMORY_SERVICE_REFRESH_EXPIRE_DAYS=7

# ---- LLM（OpenAI-compatible）----
MEMORY_SERVICE_LLM_BASE_URL=
MEMORY_SERVICE_LLM_API_KEY=
MEMORY_SERVICE_LLM_MODEL=
# 抽取/摘要用便宜模型，留空则复用主模型
MEMORY_SERVICE_EXTRACTOR_MODEL=

# ---- 向量库：pgvector（默认）或 milvus ----
MEMORY_SERVICE_VECTOR_STORE=pgvector

# ---- 观测（Langfuse self-host）----
MEMORY_SERVICE_LANGFUSE_PUBLIC_HOST=
MEMORY_SERVICE_LANGFUSE_PUBLIC_KEY=
MEMORY_SERVICE_LANGFUSE_SECRET_KEY=

# ---- 上下文预算 profile（config/budgets/*.yaml，default/memory_first/knowledge_first）----
MEMORY_SERVICE_CONTEXT_BUDGET_PROFILE=default
